# Настройки подключения к Nakama. Скопируйте в .env.local и подставьте значения.
# Все переменные попадают в клиентский бандл — секретов здесь быть не должно.

VITE_NAKAMA_HOST=dev.gritsenko.biz

# Путь реверс-прокси дописывается к порту: nakama-js не умеет базовый путь.
# Подробности — в комментарии в src/net/config.ts.
VITE_NAKAMA_PORT=443/game_api

VITE_NAKAMA_SSL=true

# socket.server_key сервера Nakama. Публичен по своей природе (уезжает в бандл),
# но в репозиторий его всё равно не коммитим.
# Посмотреть на сервере: sudo grep NAKAMA_SERVER_KEY /opt/nakama/.env
VITE_NAKAMA_SERVER_KEY=
